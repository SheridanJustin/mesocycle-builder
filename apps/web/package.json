{
  "name": "@mesocycle/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prisma:migrate": "dotenv --no-override -e ../../.env -- prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "dotenv --no-override -e ../../.env -- prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "dotenv-cli": "8.0.0",
    "eslint": "9.20.1",
    "eslint-config-next": "15.1.6",
    "prisma": "6.3.1",
    "tsx": "4.19.2",
    "vitest": "3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
