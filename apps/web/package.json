{
  "name": "@mesocycle/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "dotenv --no-override -e ../../.env -- next dev",
    "build": "dotenv --no-override -e ../../.env -- next build",
    "start": "dotenv --no-override -e ../../.env -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prisma:migrate": "dotenv --no-override -e ../../.env -- prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "dotenv --no-override -e ../../.env -- prisma db seed",
    "test:integration": "dotenv --no-override -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@mesocycle/shared": "workspace:*",
    "@prisma/client": "6.3.1",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@next/eslint-plugin-next": "15.1.6",
    "@playwright/test": "1.50.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "dotenv-cli": "8.0.0",
    "eslint": "9.20.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "postcss": "8.5.1",
    "prisma": "6.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
