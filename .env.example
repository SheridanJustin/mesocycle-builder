# Copy this file to .env and adjust for your local PostgreSQL instance.
#   PowerShell: Copy-Item .env.example .env
# .env is gitignored. Never commit real secrets.

# --- Database (read by Prisma; PostgreSQL runs natively on localhost:5432) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesocycle_builder"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesocycle_builder_test"

# --- Dev user: owns the data created before accounts existed. Create an account with this
# email (outside production) to keep it. ---
DEV_USER_EMAIL="dev@example.com"

# --- Accounts (Auth.js) ---
# Required: a random secret that signs session cookies. Generate one (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Optional: "Continue with Google". Create an OAuth client (type: Web application) in Google Cloud
# Console > APIs & Services > Credentials, with the authorized redirect URI
#   http://localhost:3000/api/auth/callback/google
# Leave both empty to hide the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
