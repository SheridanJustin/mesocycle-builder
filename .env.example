# Copy this file to .env and adjust if needed:  cp .env.example .env
# .env must be listed in .gitignore. Never commit real secrets.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=mesocycle
POSTGRES_PASSWORD=mesocycle_dev_password
POSTGRES_DB=mesocycle_dev
POSTGRES_PORT=5432

# --- App (read by Prisma and Next.js) ---
# If you change the user, password or port above, update these two to match.
DATABASE_URL=postgresql://mesocycle:mesocycle_dev_password@localhost:5432/mesocycle_dev
TEST_DATABASE_URL=postgresql://mesocycle:mesocycle_dev_password@localhost:5432/mesocycle_test

# --- Dev user (auth is out of scope; see SPEC.md section 2) ---
DEV_USER_EMAIL=dev@example.com
